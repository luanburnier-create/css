/* Efeito de hover para os cartões de postagem */
article:hover {
  transform: scale(1.02);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Ajuste da sombra no modo escuro */
@media (prefers-color-scheme: dark) {
  article:hover {
    box-shadow: 0 10px 20px rgba(59, 130, 246, 0.4); /* Azul brilhante suave */
  }
}
